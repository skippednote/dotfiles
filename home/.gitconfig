[user]
  name = Bassam Ismail
  email = skippednote@gmail.com


[core]
  fileMode = true
  pager = delta
  autocrlf = input
  commitGraph = true
  excludesfile = ~/.gitignore
  eol = lf

[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
  ui = auto

[pager]
  diff = delta
  blame = delta
  grep = delta
  log = delta
  reflog = delta
  show = delta

[interactive]
  diffFilter = delta --color-only

[help]
  autocorrect = 1



[github]
  user = skippednote

[init]
  defaultBranch = main

[pull]
  rebase = true

[rebase]
  autoStash = true

[fetch]
  prune = true

[merge]
  conflictStyle = diff3

[push]
  autoSetupRemote = true

[remote "origin"]
  prune = true

[delta]
  features = side-by-side line-numbers decorations
  side-by-side = true
  navigate = true

[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow ul
  file-decoration-style = none
  hunk-header-decoration-style = cyan box ul

[delta "line-numbers"]
  line-numbers-left-style = cyan
  line-numbers-right-style = cyan
  line-numbers-minus-style = 124
  line-numbers-plus-style = 28

[alias]
  a   = add
  co  = checkout
  cl  = clone
  cob = checkout -b
  cm  = commit -m
  cam = commit --amend --no-edit
  d   = diff
  ds  = diff --staged
  pu  = push
  puh = push origin HEAD
  puhf = push origin HEAD --force-with-lease
  pl  = pull
  s   = status
  rv  = remote -v
  rhh = reset --hard HEAD
  lp  = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  bl  = branch -l
  br  = branch -r
  cfd = clean -fd
  cf = clean -f
  ignore = update-index --assume-unchanged
  unignore = update-index --no-assume-unchanged
  fa = fetch --all
  fo = fetch origin
  st = stash
  sl = stash list
  sp = stash pop
  sc = stash clear
  sa = stash apply
  sd = stash drop
  ss = stash show
  unstage = reset HEAD --
  lg = log --oneline --decorate --graph --all
  last = log -1 --stat
  uncommit = reset --soft HEAD~1
  undo = reset --soft HEAD~1
  sync = pull --rebase
  rbi = rebase -i
  fixup = commit --fixup
  root = rev-parse --show-toplevel
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential

# Machine-specific half: commit signing needs 1Password, which is installed
# on skippednote and not on skippedbook. home-manager links the right file
# per host, so identity stays shared and only signing diverges.
[include]
  path = ~/.config/git/host.conf
