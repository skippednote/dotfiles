# skippedbook.
#
# OrbStack's include has to stay at the very top, before any Host block, or
# `ssh orb` and the Linux machines stop resolving - and OrbStack is what runs
# this machine's Kubernetes cluster.
#
# No IdentityAgent line here on purpose: 1Password is not installed on this
# machine, and pointing IdentityAgent at its missing socket made every
# outbound ssh fail with "Permission denied (publickey)".
Include ~/.orbstack/ssh/config

Host *
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519_backup
