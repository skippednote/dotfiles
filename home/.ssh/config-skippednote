# press-box must come before the `Host *` block below: ssh takes the first
# value it obtains for each option, so a later block cannot override it.
#
# It exists because backup-press.sh runs unattended from a launchd agent and
# calls plain `ssh`. Under the `Host *` rule that would route through the
# 1Password agent, which prompts for approval on this machine's display -
# fine when typing a command, fatal for a 03:40 backup with nobody watching.
# This alias uses an on-disk key and no agent, so it never prompts.
Host press-box
  HostName 46.224.90.192
  User root
  IdentityAgent none
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# BEGIN: Upsun certificate configuration
Host *.platform.sh *.upsun.com
  Include ~/.upsun-cli/ssh/*.config
Host *
# END: Upsun certificate configuration
